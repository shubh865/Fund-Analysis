# Copy this file to .env and choose your private Super Admin account before starting the site.
# This account becomes the initial, sole Super Admin on a new database.
AUTH_USERNAME=your-admin-username
AUTH_PASSWORD=replace-with-a-private-password-of-at-least-10-characters

# Local, free AI assistant. Ollama runs only on this computer; no paid API key is used.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=gemma3:4b
